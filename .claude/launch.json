{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "expo-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "admin-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "admin-web",
        "run",
        "dev",
        "--",
        "--port",
        "5183"
      ],
      "port": 5183
    },
    {
      "name": "admin-mock",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "admin-web",
        "run",
        "dev",
        "--",
        "--config",
        "vite.mock.config.ts",
        "--port",
        "5184"
      ],
      "port": 5184
    },
    {
      "name": "landing",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "live-server",
        "landing",
        "--port=4173",
        "--no-browser",
        "--wait=200"
      ],
      "port": 4173
    }
  ]
}